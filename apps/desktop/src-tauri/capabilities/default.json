{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "All Pando windows",
  "windows": [
    "main",
    "pando-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
