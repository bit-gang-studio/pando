{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pando",
  "identifier": "studio.bitgang.pando",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pando",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNUQ0OTc0QUU4MjlCMEUKUldRT200S3VkRWxkaXQwdWNnNWtLUlBHWmNuK05MSDl3Y0VQV25RK1NjOGlLRStTeDg3Lzg4ay8K",
      "endpoints": [
        "https://github.com/bit-gang-studio/pando/releases/latest/download/latest.json"
      ]
    }
  }
}
